{
  "zoomed_padding": true,
  "tab_bar": {
    "show_tab_bar_buttons": true
  },
  "mouse_wheel_zoom": false,
  "file_finder": {
    "include_ignored": "smart"
  },
  "search": {
    "include_ignored": false
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "line_endings_button": true
  },
  "use_system_window_tabs": true,
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": true,
    "git_status": false
  },
  "prettier": {
    "allowed": true
  },
  "restore_on_startup": "launchpad",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "show_edit_predictions": false,
  "show_wrap_guides": true,
  "soft_wrap": "none",
  "gutter": {
    "folds": true,
    "bookmarks": false
  },
  "proxy": "",
  "diff_view_style": "unified",
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "effort": [
          "max"
        ],
        "model": [
          "opencode-go/deepseek-v4-flash",
          "opencode-go/deepseek-v4-pro"
        ]
      },
      "default_config_options": {
        "model": "opencode-go/deepseek-v4-flash",
        "mode": "build",
        "effort": "max",
      },
      "type": "registry",
    },
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "hide_root": false,
    "bold_folder_labels": false,
    "folder_icons": true,
    "dock": "left",
  },
  "outline_panel": {
    "folder_icons": true,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "show_turn_stats": true,
    "sidebar_side": "right",
    "enable_feedback": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "folder_icons": true,
    "sort_by": "path",
    "group_by": "status",
    "tree_view": false,
    "dock": "left",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "which_key": {
    "delay_ms": 50,
    "enabled": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
    "provider": "zed",
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato",
  },
  "terminal": {
    "dock": "right",
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13.0,
  },
  "git": {
    "inline_blame": {
      "delay_ms": 500,
      "show_commit_summary": true,
      "location": "status_bar",
      "enabled": true,
    },
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "prefer_line"
    },
    "PHP": {
      "language_servers": ["intelephense", "!phpactor"],
      "formatter": {
        "external": {
          "command": "php-cs-fixer",
          "arguments": ["fix", "--using-cache=no", "{buffer_path}"],
        },
      },
    },
    "Go": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": true,
    },
  },
}
