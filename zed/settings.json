          "xdebug",
          "xml",
          "xmlreader",
          "xmlrpc",
          "xmlwriter",
          "xsl",
          "Zend OPcache",
          "zip",
          "zlib",
        ],
      },
    },
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "prefer_line",
    },
    "PHP": {
      "language_servers": ["intelephense", "!phpactor"],
      "format_on_save": "off",
      "use_on_type_format": false,
      "prettier": { "allowed": false },
    },
    "Go": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": true,
    },
  },
}
