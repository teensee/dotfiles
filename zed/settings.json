{
  "ssh_connections": [
    {
      "host": "keenetic",
      "args": [],
      "projects": [
        {
          "paths": ["/opt/root"],
        },
      ],
    },
    {
      "host": "delta-host",
      "args": [],
      "projects": [
        {
          "paths": ["/home/vlad"],
        },
      ],
    },
    {
      "host": "ru.delta-node",
      "args": [],
      "projects": [
        {
          "paths": ["/home/vlad"],
        },
      ],
    },
  ],
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "code_lens": "on",
  "zoomed_padding": true,
  "tab_bar": {
    "show_tab_bar_buttons": true,
  },
  "mouse_wheel_zoom": false,
  "file_finder": {
    "include_ignored": "smart",
  },
  "search": {
    "include_ignored": false,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "line_endings_button": true,
  },
  "use_system_window_tabs": true,
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": true,
    "git_status": false,
  },
  "prettier": {
    "allowed": true,
  },
  "restore_on_startup": "launchpad",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "show_edit_predictions": false,
  "show_wrap_guides": true,
  "soft_wrap": "none",
  "gutter": {
    "folds": true,
    "bookmarks": false,
  },
  "proxy": "",
  "diff_view_style": "split",
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "effort": ["max"],
        "model": [
          "opencode-go/deepseek-v4-flash",
          "opencode-go/deepseek-v4-pro",
        ],
      },
      "default_config_options": {
        "model": "opencode-go/deepseek-v4-flash",
        "mode": "build",
        "effort": "high",
      },
      "type": "registry",
    },
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "hide_root": false,
    "bold_folder_labels": false,
    "folder_icons": true,
    "dock": "left",
  },
  "outline_panel": {
    "folder_icons": true,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "show_turn_stats": true,
    "sidebar_side": "right",
    "enable_feedback": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "folder_icons": true,
    "sort_by": "path",
    "group_by": "status",
    "tree_view": false,
    "dock": "left",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "which_key": {
    "delay_ms": 50,
    "enabled": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
    "provider": "zed",
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato - No Italics",
  },
  "terminal": {
    "dock": "right",
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13.0,
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv", ".env", "env"],
        "activate_script": "default",
      },
    },
  },
  "git": {
    "inline_blame": {
      "delay_ms": 500,
      "show_commit_summary": true,
      "location": "status_bar",
      "enabled": true,
    },
  },
  "lsp": {
    "intelephense": {
      "settings": {
        "format": { "enable": false },
        "throwDepth": 3,
        "completion": { "propertyCase": "camel" },
        "stubs": [
          "amqp",
          "apache",
          "apcu",
          "bcmath",
          "bz2",
          "calendar",
          "com_dotnet",
          "Core",
          "ctype",
          "curl",
          "date",
          "dba",
          "dom",
          "enchant",
          "exif",
          "FFI",
          "fileinfo",
          "filter",
          "fpm",
          "ftp",
          "gd",
          "gettext",
          "gmp",
          "hash",
          "iconv",
          "igbinary",
          "imagick",
          "imap",
          "intl",
          "json",
          "ldap",
          "libxml",
          "mbstring",
          "memcached",
          "meta",
          "mongodb",
          "msgpack",
          "mysqli",
          "oci8",
          "odbc",
          "openssl",
          "pcntl",
          "pcov",
          "pcre",
          "PDO",
          "pdo_ibm",
          "pdo_mysql",
          "pdo_pgsql",
          "pdo_sqlite",
          "pgsql",
          "Phar",
          "posix",
          "pspell",
          "random",
          "rdkafka",
          "readline",
          "redis",
          "Reflection",
          "regex",
          "session",
          "shmop",
          "SimpleXML",
          "snmp",
          "soap",
          "sockets",
          "sodium",
          "SPL",
          "sqlite3",
          "standard",
          "superglobals",
          "sysvmsg",
          "sysvsem",
