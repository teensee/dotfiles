[user]
	name = vlad
	email = stimulmonk@yandex.ru

[core]
	autocrlf = input
	excludesfile = /Users/vladislav/.gitignore_global
	pager = delta

[alias]
    stats = "!f() { git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s\\nremoved lines: %s\\ntotal lines: %s\\n\", add, subs, loc }' -; }; f"

[includeIf "gitdir:~/PhpstormProjects/projects/etp/"]
    path = ~/.gitconfig-etp

[includeIf "gitdir:~/Programming/Go/elk_hub/"]
    path = ~/.gitconfig-etp

; Optional per-host overrides; copy from *.example and `make install` to symlink.
[include]
    path = ~/.gitconfig-local
    path = ~/.gitconfig-work

[merge]
	conflictstyle = diff3
	tool = vscode

[mergetool "vscode"]
	cmd = \"/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code\" --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"
	trustExitCode = false

[mergetool]
	keepBackup = false
	prompt = false

[diff]
	colorMoved = default
	tool = vscode

[difftool "vscode"]
	cmd = \"/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code\" --wait --diff \"$LOCAL\" \"$REMOTE\"

[difftool]
	prompt = false

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
