{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "provider": {
    "vesna": {
      "name": "vesna",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "VesnaCode": {
          "name": "VesnaCode",
        },
      },
      "options": {
        "baseURL": "https://ai-api.vesna-tech.ru",
        "apiKey": "{env:VESNA_API_KEY}",
        "queryParams": {
          "tool_call_parser": "qwen3_coder",
        },
      },
    },
  },
  "lsp": true,
  "formatter": true,
  "agent": {
    "architect": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "code-reviewer": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "dba": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "debugger": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "devops": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "go-dev": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "python-pro": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "research": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "rust-engineer": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "security-auditor": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "symfony-dev": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "test-writer": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "zig-dev": {
      "model": "opencode-go/deepseek-v4-flash"
    },
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "which*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "rg*": "allow",
      "git *": "deny",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -r*": "allow",
      "git branch -a*": "allow",
      "git branch -l*": "allow",
      "git branch --*": "allow",
      "git remote*": "allow",
      "git config*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git reflog*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git stash list*": "allow",
      "git stash show*": "allow",
      "git tag -l*": "allow",
      "git --*": "allow",
    },
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
  },
}
