{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "provider": {
    "vesna": {
      "name": "vesna",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "VesnaCode": {
          "name": "VesnaCode",
        },
      },
      "options": {
        "baseURL": "https://ai-api.vesna-tech.ru",
        "apiKey": "{env:VESNA_API_KEY}",
        "queryParams": {
          "tool_call_parser": "qwen3_coder",
        },
      },
    },
  },
  "lsp": true,
  "formatter": true,
  "instructions": ["{env:HOME}/.config/opencode/instructions.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "which*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "echo*": "allow",
      "cat*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "git *": "deny",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -r*": "allow",
      "git branch -a*": "allow",
      "git branch -l*": "allow",
      "git branch --*": "allow",
      "git remote*": "allow",
      "git config*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git reflog*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git stash list*": "allow",
      "git stash show*": "allow",
      "git tag -l*": "allow",
      "git --*": "allow",
      "find /*": "deny",
      "find * /": "deny",
      "find * /*": "deny",
      "fd /*": "deny",
      "fd * /": "deny",
      "fd * /*": "deny",
      "rg /": "deny",
      "rg * /": "deny",
      "rg * /*": "deny",
      "grep * /": "deny",
      "grep * /*": "deny",
      "locate *": "deny",
      "mdfind *": "deny",
    },
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "environment": {
        "DATABASE_URI": "{env:DATABASE_OPENCODE_RO_URI}",
      },
      "enabled": false,
    },
  },
}
