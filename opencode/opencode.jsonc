{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "lsp": true,
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "deny",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -r*": "allow",
      "git branch -a*": "allow",
      "git branch -l*": "allow",
      "git branch --*": "allow",
      "git remote*": "allow",
      "git config*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git reflog*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git stash list*": "allow",
      "git stash show*": "allow",
      "git tag -l*": "allow",
      "git --*": "allow"
    }
  }
}
