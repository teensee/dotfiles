{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "providers": {
    "vesna": {
      "name": "vesna",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "env": ["VESNA_API_KEY"],
      "settings": {
        "baseURL": "https://ai-api.vesna-tech.ru",
        "queryParams": {
          "tool_call_parser": "qwen3_coder",
        },
      },
      "models": {
        "VesnaCode": {
          "name": "VesnaCode",
          "limit": {
            "context": 262144,
            "output": 32768,
          },
        },
      },
    },
  },
  "agents": {
    "architect": { "model": "opencode-go/deepseek-v4-pro" },
    "code-reviewer": { "model": "opencode-go/deepseek-v4-pro" },
    "dba": { "model": "opencode-go/glm-5.2" },
    "debugger": { "model": "opencode-go/deepseek-v4-pro" },
    "devops": { "model": "opencode-go/deepseek-v4.1-flash" },
    "go-dev": { "model": "opencode-go/deepseek-v4.1-flash" },
    "python-pro": { "model": "opencode-go/deepseek-v4.1-flash" },
    "research": { "model": "opencode-go/deepseek-v4-pro" },
    "rust-engineer": { "model": "opencode-go/deepseek-v4.1-flash" },
    "security-auditor": { "model": "opencode-go/deepseek-v4-pro" },
    "symfony-dev": { "model": "opencode-go/deepseek-v4.1-flash" },
    "test-writer": { "model": "opencode-go/deepseek-v4.1-flash" },
    "zig-dev": { "model": "opencode-go/deepseek-v4.1-flash" },
  },
  "lsp": true,
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ls*", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "which*", "effect": "allow" },
    { "action": "shell", "resource": "head*", "effect": "allow" },
    { "action": "shell", "resource": "tail*", "effect": "allow" },
    { "action": "shell", "resource": "echo*", "effect": "allow" },
    { "action": "shell", "resource": "jq*", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "cat*", "effect": "allow" },
    { "action": "shell", "resource": "rg*", "effect": "allow" },
    { "action": "shell", "resource": "grep*", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "sed*", "effect": "allow" },
    { "action": "shell", "resource": "sort*", "effect": "allow" },
    { "action": "shell", "resource": "uniq*", "effect": "allow" },
    { "action": "shell", "resource": "sed -i*", "effect": "ask" },
    { "action": "shell", "resource": "sed * -i*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "deny" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "git branch -r*", "effect": "allow" },
    { "action": "shell", "resource": "git branch -a*", "effect": "allow" },
    { "action": "shell", "resource": "git branch -l*", "effect": "allow" },
    { "action": "shell", "resource": "git branch --*", "effect": "allow" },
    { "action": "shell", "resource": "git remote*", "effect": "allow" },
    { "action": "shell", "resource": "git config*", "effect": "allow" },
    { "action": "shell", "resource": "git blame*", "effect": "allow" },
    { "action": "shell", "resource": "git grep*", "effect": "allow" },
    { "action": "shell", "resource": "git reflog*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list*", "effect": "allow" },
    { "action": "shell", "resource": "git stash list*", "effect": "allow" },
    { "action": "shell", "resource": "git stash show*", "effect": "allow" },
    { "action": "shell", "resource": "git tag -l*", "effect": "allow" },
    { "action": "shell", "resource": "git --*", "effect": "allow" },
    { "action": "shell", "resource": "find /*", "effect": "deny" },
    { "action": "shell", "resource": "find * /", "effect": "deny" },
    { "action": "shell", "resource": "find * /*", "effect": "deny" },
    { "action": "shell", "resource": "fd /*", "effect": "deny" },
    { "action": "shell", "resource": "fd * /", "effect": "deny" },
    { "action": "shell", "resource": "fd * /*", "effect": "deny" },
    { "action": "shell", "resource": "rg /", "effect": "deny" },
    { "action": "shell", "resource": "rg * /", "effect": "deny" },
    { "action": "shell", "resource": "rg * /*", "effect": "deny" },
    { "action": "shell", "resource": "grep * /", "effect": "deny" },
    { "action": "shell", "resource": "grep * /*", "effect": "deny" },
    { "action": "shell", "resource": "locate *", "effect": "deny" },
    { "action": "shell", "resource": "mdfind *", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "codemode": false,
      },
      "postgres": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
        "environment": {
          "DATABASE_URI": "{env:DATABASE_OPENCODE_RO_URI}",
        },
        "disabled": true,
        "codemode": false,
      },
    },
  },
}
